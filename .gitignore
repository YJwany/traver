__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
!.env.example
travel.db
# Local SQLite artefacts from running the API, the live tests or Alembic.
*.db
*.db-journal
*.db-wal
*.db-shm
!docs/**/*.db
*.sqlite3
# Credential-vault master key. This decrypts every stored third-party API key, so
# committing it would hand out all of them at once. Ignored by name and by the
# generic pattern so a renamed or relocated key file cannot be committed either.
.traver-credential-key
*.credential-key
**/.traver-credential-key
node_modules/
.next/
dist/
coverage/
htmlcov/
*.egg-info/
.DS_Store
# TypeScript incremental build state. Committing it produces a tracked artefact
# that changes on every build, so every diff carries noise and CI can disagree
# with a developer's stale cache.
*.tsbuildinfo
# Vitest / Vite caches.
.vitest/
vite.config.ts.timestamp-*
