# Normalize line endings across the Windows dev / Linux CI boundary.
#
# Without this, Git's `core.autocrlf` converts text to CRLF on checkout, and CI
# (ubuntu-latest) then runs files whose line endings are not what was tested
# locally. That breaks `sh` scripts and container builds in ways that only show
# up in CI — the `.gitattributes` file is the fix, applied before the first
# commit so the repository never carries ambiguous endings.

# Default: text files are stored with LF in the repository, whatever the client
# platform. `text=auto` also normalizes files already committed.
* text=auto eol=lf

# Explicit for the types where a stray CR is a functional bug, not cosmetics.
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
.env.example text eol=lf
.gitignore text eol=lf

# Windows-only scripts must keep CRLF, or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary: never touch these. `text=auto` would otherwise try to normalize a
# database or image and corrupt it.
*.db binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary

# Lock files are generated; keep them out of diffs and merge conflicts.
package-lock.json -diff linguist-generated
requirements.lock -diff linguist-generated
