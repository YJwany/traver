# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# SQLite is the zero-setup default; set the Postgres URL for the compose stack.
DATABASE_URL=sqlite:///./travel.db
# Create tables on startup. Convenient for local runs; use Alembic in production.
AUTO_CREATE_SCHEMA=true

# ---------------------------------------------------------------------------
# Provider composition
# ---------------------------------------------------------------------------
# Free, keyless sources (OpenStreetMap, Open-Meteo, OSRM) are the default data
# layer. The mock provider is opt-in so synthetic places and prices never mix
# into real results; it stays available for offline and deterministic tests.
FREE_PROVIDERS_ENABLED=true
MOCK_PROVIDER_ENABLED=false
PROVIDER_FIXTURE_DIR=

# ---------------------------------------------------------------------------
# Provider resilience (applies to every provider)
# ---------------------------------------------------------------------------
# Baseline budget for one provider call. Individual providers may override it;
# the free community endpoints do, because Overpass legitimately takes seconds.
PROVIDER_TIMEOUT_SECONDS=15
# The free HTTP layer retries transient failures itself, so the runtime retry
# only needs to catch a provider-level failure.
PROVIDER_RETRY_COUNT=1
PROVIDER_BACKOFF_SECONDS=1.0
PROVIDER_CIRCUIT_BREAKER_THRESHOLD=3
PROVIDER_CIRCUIT_BREAKER_RESET_SECONDS=30

# ---------------------------------------------------------------------------
# Free providers
# ---------------------------------------------------------------------------
# The Nominatim usage policy requires a descriptive User-Agent identifying your
# application. Verified live: an e-mail address in the UA returns HTTP 403
# "Access denied", and httpx's default UA is rejected too. A plain token plus a
# "+https://..." contact URL works. Put a real contact URL here before any
# non-local use.
FREE_PROVIDER_USER_AGENT=TraverTravelPlanner/0.1 (+https://example.invalid/traver)
FREE_PROVIDER_LANGUAGE=zh
# Budget for one whole free-provider call. Must comfortably exceed
# (mirror attempts x request timeout) so mirror fallback can actually run
# instead of being cut off after the first slow mirror.
FREE_PROVIDER_TIMEOUT_SECONDS=90
# Timeout for a single HTTP request to a community endpoint.
FREE_PROVIDER_REQUEST_TIMEOUT_SECONDS=25
# Half-width of the POI search box in degrees (~5 km at these latitudes). Kept
# small because Overpass query cost grows with area.
FREE_PROVIDER_BBOX_RADIUS_DEGREES=0.045
FREE_PROVIDER_POI_TTL_SECONDS=3600
FREE_PROVIDER_WEATHER_TTL_SECONDS=900
FREE_PROVIDER_NOMINATIM_FALLBACK=true
# Air quality (PM2.5 / European AQI / UV) from Open-Meteo. Best-effort: if it
# fails the trip keeps its forecast, just without air-quality fields. Its
# horizon is 7 days (the forecast endpoint allows 16), so later days stay empty
# rather than defaulting to "clean".
FREE_PROVIDER_AIR_QUALITY_ENABLED=true
# Public holidays from the MIT-licensed `holidays` library: local data, no
# network, no API key, free for commercial use. Covers China including the 调休
# rest days. No web API is used here because the available free ones either
# require sponsorship for commercial use or omit the bridge days.
FREE_PROVIDER_HOLIDAYS_ENABLED=true
# Leave empty to geocode the destination and use its ISO country code.
FREE_PROVIDER_HOLIDAYS_COUNTRY_CODE=
# Attraction descriptions from Wikipedia/Wikidata (CC BY-SA 4.0, attribution
# required). Applied ONLY to POIs carrying an explicit OSM wikipedia/wikidata
# tag; matches are never guessed from the name.
FREE_PROVIDER_WIKIPEDIA_ENABLED=true
# Article text changes slowly, so this TTL is far longer than for POIs.
FREE_PROVIDER_WIKIPEDIA_TTL_SECONDS=604800
# Retries inside the shared free HTTP client, with exponential backoff. The
# public endpoints intermittently drop the first connection, so this is what
# makes real-data runs dependable. Rate limits still apply to every attempt
# because each one passes through the per-host limiter.
FREE_PROVIDER_RETRY_COUNT=3
FREE_PROVIDER_RETRY_BACKOFF_SECONDS=0.5
# Overpass mirrors, tried in order. The main instance returns HTTP 504 under
# load, so alternatives are useful. Please keep the request rate low.
OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# Leave empty for the default routing server: FOSSGIS (routing.openstreetmap.de),
# which has real worldwide foot, bike and car profiles. Set it to the OSRM demo
# server (https://router.project-osrm.org) or your own instance to change that.
#
# The demo server routes CARS ONLY, and it does not say so: asking it for a foot
# route returns HTTP 200 with car durations. Traver therefore treats any server it
# does not recognise as car-only, and derives walking times from the road distance
# (flagged as estimates) rather than believing a car time.
OSRM_BASE_URL=
# Comma-separated profiles the configured server honours: driving, foot, bike.
# Only needed for a self-hosted instance, which is assumed car-only otherwise.
OSRM_HONOURED_PROFILES=

# ---------------------------------------------------------------------------
# 高德地图 (AMap) — optional, per-owner credentials
# ---------------------------------------------------------------------------
# 高德 is the only source here that can plan 公交/地铁, which the free stack cannot
# do at all (the public OSRM demo has no transit profile). It is entirely optional:
# with nothing configured, plans are built from the free sources.
#
# The KEY is NOT set here. Each owner enters their own Web 服务 Key on the settings
# page ("/settings"), where it is encrypted per-owner in the credential vault. An
# operator-level key would be shared by every owner and would spend one person's
# quota for everyone, so there is deliberately no AMAP_KEY setting.
#
# Create a 「Web 服务」 type key (not JS API — they are different types and a JS key
# is rejected) at https://console.amap.com/dev/key/app
#
# Set to false to withdraw 高德 from the catalogue entirely for this deployment.
AMAP_ENABLED=true
# Override the API host, for a proxy or an offline test double.
AMAP_BASE_URL=https://restapi.amap.com
# Lifetime stamped on 高德 data. Deliberately minutes, not hours:
#
#   * 高德's terms forbid storing or caching results, so this program performs NO
#     caching of its data — every plan is a live query;
#   * and a cached price or route duration presented as current is exactly the
#     misrepresentation the freshness rules exist to prevent.
#
# The expiry therefore only bounds how long a persisted snapshot may still be shown
# as current.
AMAP_TTL_SECONDS=300
# How many places 高德 will route per trip.
#
# Each point beyond the distance sweep costs one more request, and the free personal
# quota is a monthly call count — so this is a real cost decision, and it belongs to
# whoever owns the key. The planner assembles up to 40 points; anything past this
# budget has its travel time estimated, and the route's own source reference reports
# that (truncated / points_offered / points_routed) rather than leaving a measured leg
# indistinguishable from an estimated one.
#
# The default matches the free OSRM provider's budget, so supplying a key never
# *reduces* how much of an itinerary gets a measured route.
#
# 高德's distance-matrix endpoint accepts at most 100 origins per request. That is a
# property of the protocol rather than a preference, so it is clamped in code
# (AMAP_MAX_MATRIX_ORIGINS in providers/amap/routing.py) instead of being a setting
# that could be raised into a request 高德 would reject.
AMAP_MAX_ROUTE_POINTS=25
# Requests per second allowed against the 高德 host. The free personal quota is a
# monthly call count, but 高德 also enforces a per-second guard, so a burst is
# throttled rather than allowed to trip it.
AMAP_REQUESTS_PER_SECOND=5.0

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# When true, every trip route requires a bearer API key and results are scoped
# to that key's owner. The default is false so a fresh clone runs without key
# management; /api/v1/health reports the active mode either way, so an
# unsecured deployment is never mistaken for a secured one.
#
# Turn this ON before exposing the API beyond localhost. With auth off, any
# client that can reach the port can read and modify every trip.
AUTH_ENABLED=false
# Owner attributed to requests while AUTH_ENABLED=false.
AUTH_ANONYMOUS_OWNER=local-dev
# Optional first credential, registered at startup. It must start with "trv_".
# Leave blank in production and mint keys with:
#     python -m travel_api.cli create-key --owner <you> --label <device>
# Only its SHA-256 hash is stored; the value is never re-read for comparison,
# so revoking a key is not undone by the next restart.
AUTH_BOOTSTRAP_KEY=
AUTH_BOOTSTRAP_OWNER=admin

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated browser origins. Blank uses the localhost:3000 development
# pair. Set this explicitly once the Web app and API are not both on localhost,
# otherwise every browser request is blocked.
CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------------------
# Inbound rate limiting
# ---------------------------------------------------------------------------
# Applied to the API itself, per client. Distinct from the outbound per-host
# limiter, which exists to honour upstream providers' usage policies. The AI
# endpoint has its own tighter budget because it can spend model tokens.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=20

# ---------------------------------------------------------------------------
# Budget fallbacks
# ---------------------------------------------------------------------------
# Used only when no priced source exists for a category, which is always the
# case for the free data layer (OSM carries no prices). Every resulting budget
# line is flagged is_estimate=true. These are planning allowances, never
# observed commercial facts. Override them, or connect a commercial provider.
BUDGET_FALLBACK_HOTEL_PER_NIGHT=400
BUDGET_FALLBACK_FOOD_PER_PERSON_PER_DAY=120
BUDGET_FALLBACK_ATTRACTION_PER_PERSON_PER_DAY=80
BUDGET_FALLBACK_TRANSPORT_PER_PERSON_PER_DAY=50

# ---------------------------------------------------------------------------
# Freshness (seconds)
# ---------------------------------------------------------------------------
FRESHNESS_HOTEL_OFFER=300
FRESHNESS_HOTEL_AVAILABILITY=120
FRESHNESS_RESTAURANT=1800
FRESHNESS_ATTRACTION=3600
FRESHNESS_WEATHER=900
FRESHNESS_ROUTE=600

# ---------------------------------------------------------------------------
# AI (optional). Without a key the Web app still plans with local rules.
# ---------------------------------------------------------------------------
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1200
AI_MAX_TOOL_CALLS=20
AI_MAX_SAME_TOOL_CALLS=5
CONVERSATION_RECENT_MESSAGES=12

# ---------------------------------------------------------------------------
# Credential vault (optional). Stores each user's own third-party API keys so
# they can be used, which means they must be recoverable and are therefore
# encrypted with AES-256-GCM rather than hashed. Everything above still works
# with nothing set here: a key file is created on first use.
# ---------------------------------------------------------------------------
# Master key: urlsafe base64 of 32 bytes. Generate with:
#   python -c "from travel_api.services.credentials import generate_master_key; print(generate_master_key())"
# Setting it is the stronger option, because the key then lives only in this
# environment and never on the filesystem or in a database backup. When blank,
# CREDENTIAL_KEY_FILE is used instead and created on first use. Leave it blank in
# an example file, never paste a real key here.
CREDENTIAL_ENCRYPTION_KEY=
# Where the master key is kept when CREDENTIAL_ENCRYPTION_KEY is blank.
CREDENTIAL_KEY_FILE=.traver-credential-key
# Set false to refuse all stored-credential reads and writes. The app still runs
# entirely from the environment values above.
CREDENTIAL_VAULT_ENABLED=true
